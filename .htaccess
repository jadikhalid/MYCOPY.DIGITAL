# Minimal Hostinger / Apache security
Options -Indexes

<FilesMatch "\.(sqlite|sqlite3|db|env)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(config\.smtp\.php|config\.php|db\.php)$">
  # .php files remain executable; mainly block dumps
</FilesMatch>

# Block direct download of SMTP config if served as static
<Files "config.smtp.php">
  Require all denied
</Files>

<Files "config.smtp.example.php">
  Require all denied
</Files>
