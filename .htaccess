# Minimal Hostinger / Apache security + pretty URL routing
Options -Indexes

<FilesMatch "\.(sqlite|sqlite3|db|env)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(config\.smtp\.php|config\.php|db\.php)$">
  # .php files remain executable; mainly block dumps
</FilesMatch>

# Block direct download of SMTP config if served as static
<Files "config.smtp.php">
  Require all denied
</Files>

<Files "config.smtp.example.php">
  Require all denied
</Files>

<Files "config.admin.php">
  Require all denied
</Files>

<Files "config.admin.example.php">
  Require all denied
</Files>

<Files "config.stripe.php">
  Require all denied
</Files>

<Files "config.stripe.example.php">
  Require all denied
</Files>

<Files "config.gemini.php">
  Require all denied
</Files>

<Files "config.gemini.example.php">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Page slugs that must win over a same-named leftover folder on the server
  RewriteRule ^studio/$ /studio [R=301,L,QSA]
  RewriteRule ^studio$ route.php?r=studio [L,QSA]

  # Trailing slash → no slash (keep assets/ relative paths working)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Legacy .php → pretty URLs (THE_REQUEST avoids DirectoryIndex loops on /)
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^index\.php$ /home [R=301,L,QSA]
  RewriteCond %{THE_REQUEST} \s/+attente\.php[\s?] [NC]
  RewriteRule ^attente\.php$ /waitlist [R=301,L,QSA]
  RewriteCond %{THE_REQUEST} \s/+vault\.php[\s?] [NC]
  RewriteRule ^vault\.php$ /studio [R=301,L,QSA]
  RewriteCond %{THE_REQUEST} \s/+access\.php[\s?] [NC]
  RewriteRule ^access\.php$ /home [R=301,L,QSA]

  # Old slug alias
  RewriteRule ^accueil/?$ /home [R=301,L,QSA]

  # Existing files and directories (api, assets, admin, payments, …)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Pretty slug → front controller (add future pages in routes.php only)
  RewriteRule ^([a-z0-9-]+)/?$ route.php?r=$1 [L,QSA]
</IfModule>
